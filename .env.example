# Copy to .env and set a real password. Grafana's admin login is only needed to edit;
# anonymous LAN visitors get read-only access.
GRAFANA_ADMIN_PASSWORD=change-me
# The address browsers use for Grafana; image export breaks if it doesn't match.
# GRAFANA_ROOT_URL=http://pi.internal.accapehart.com/
# Shared secret between Grafana and the image renderer.
RENDERER_TOKEN=change-me-too
